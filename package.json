{
  "name": "darkroom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.app.json && vite build",
    "build:pages": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "reference": "node --experimental-strip-types --import ./tools/reference/resolve-hook.js tools/reference/dump.ts",
    "generate:stocks": "node --experimental-strip-types --import ./tools/reference/resolve-hook.js tools/reference/generate-stocks.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
